{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.org/contracts/opensearch/meridian.opensearch.layout.v1.schema.json",
  "title": "Meridian OpenSearch Resource Layout V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "resourceRef", "schemaRef", "schemaFingerprint", "profileKind",
    "profileFingerprint", "analysisFingerprint", "mappingFingerprint", "fields", "identity",
    "sourceFields", "facetFields", "highlightFields", "ranking", "indexBody"
  ],
  "properties": {
    "formatVersion": { "const": "meridian.opensearch.layout.v1" },
    "resourceRef": { "type": "string", "pattern": "^structured:" },
    "schemaRef": { "type": "string", "minLength": 1 },
    "schemaFingerprint": { "$ref": "#/$defs/fingerprint" },
    "profileKind": { "enum": ["document", "search"] },
    "profileFingerprint": { "$ref": "#/$defs/fingerprint" },
    "analysisFingerprint": { "$ref": "#/$defs/fingerprint" },
    "mappingFingerprint": { "$ref": "#/$defs/fingerprint" },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "identity": { "$ref": "#/$defs/fieldNames" },
    "sourceFields": { "$ref": "#/$defs/fieldNames" },
    "facetFields": { "$ref": "#/$defs/fieldNames" },
    "highlightFields": { "$ref": "#/$defs/fieldNames" },
    "ranking": { "type": "string", "minLength": 1 },
    "indexBody": { "type": "object" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fieldNames": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalName", "physicalName", "logicalKind", "cardinality", "modes", "language",
        "sourceField", "jsonPointer"
      ],
      "properties": {
        "logicalName": { "type": "string", "minLength": 1 },
        "physicalName": { "type": "string", "pattern": "^[fp]_[0-9a-f]{24}$" },
        "logicalKind": { "type": "string", "minLength": 1 },
        "cardinality": { "enum": ["one", "many"] },
        "modes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["exact", "exists", "facet", "full-text", "highlight", "prefix", "range"] }
        },
        "language": { "type": ["string", "null"] },
        "sourceField": { "type": ["string", "null"] },
        "jsonPointer": { "type": ["string", "null"] }
      }
    }
  }
}
